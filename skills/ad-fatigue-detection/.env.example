# Ad Fatigue Detection — credentials template.
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# NEVER commit the real .env. Only this .example (placeholders) belongs in git.

# ── Required: Meta Marketing API ──────────────────────────────────────────
# A Meta access token with ads_read on the target ad account.
META_ACCESS_TOKEN=your_meta_access_token_here
# Ad account id, digits only or with the act_ prefix (e.g. 1234567890).
META_AD_ACCOUNT_ID=your_ad_account_id_here

# Meta Insights action_type(s) that count as the account's primary conversion.
# Comma-separated. Custom pixel events are often returned by
# Meta under this generic key (the display names do not appear in Insights):
FATIGUE_CONVERSION_ACTION_TYPES=offsite_conversion.fb_pixel_custom

# ── Conversion-evidence attestation (fail closed) ─────────────────────────
# Setting the action_type above only says WHICH Meta event to read. It does not
# establish that the event fires reliably — pixel events can silently break,
# so Meta-only conversion counts are never trusted on their own.
#
# While this is unset, conversion-optimised ads are still SCORED, but every
# human-facing verdict is reported as "Directional", their spend is not counted
# as at risk, and their cutoffs are excluded from calibration.
#
# Set BOTH only after cross-checking Meta's conversion counts against an
# independent source. Naming the source is what makes the attestation auditable.
# FATIGUE_CONVERSION_EVIDENCE_VERIFIED=true
# FATIGUE_CONVERSION_EVIDENCE_SOURCE=warehouse signup table, checked 2026-01-15

# ── Decision guardrails ───────────────────────────────────────────────────
# Minimum spend in the window before a score becomes an operational verdict
# (anything below this is directional only). This is SEPARATE
# from the internal computational floor that gates "Insufficient Data". Values
# below 500 are raised to the policy floor.
# FATIGUE_MIN_DECISION_SPEND=500

# Live scoring window. Back-testing scores every historical cutoff through the
# same lookback, and a calibration fit on a different one is rejected. Values
# too short to hold the required baseline history are raised to that minimum.
# FATIGUE_SCORING_LOOKBACK_DAYS=30

# Meta's attribution backfill keeps revising the most recent days. Windows end at
# the AD ACCOUNT's local date minus this lag; newer days are marked unsettled and
# cannot support a verdict or trigger the zero-conversion collapse override. The
# lag cannot be lowered below 3, and a missing account timezone aborts the run.
# FATIGUE_SETTLEMENT_LAG_DAYS=3

# ── Optional: Claude (reserved for planned narrative insights) ────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── Optional: Slack alerting (planned). Channel is skipped if unset. ──────
SLACK_FATIGUE_WEBHOOK_URL=

# ── Optional: CLI/reporting display only. Scores are currency-agnostic. ───
FATIGUE_CURRENCY=USD

# ── Optional: Meta async report behavior for long daily pulls. ────────────
META_ASYNC_INSIGHTS_DAYS=90
META_ASYNC_POLL_SECONDS=5
META_ASYNC_TIMEOUT_SECONDS=900
META_INSIGHTS_PAGE_LIMIT=1000

# Optional persistence overrides (defaults to ./data/).
# FATIGUE_DATA_DIR=/absolute/path/to/data
# FATIGUE_CALIBRATION_PATH=/absolute/path/to/calibration.json
